{
  "name": "@c2-poly/compliance-core",
  "version": "0.1.0",
  "description": "The engine that reads a compliance repo (C2-POLY/compliance-spec v0.1 and v0.2) and builds its register or dossier.",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./fs": {
      "types": "./dist/fs.d.ts",
      "default": "./dist/fs.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "schemas",
    "templates",
    "LICENSE",
    "NOTICE",
    "README.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "node scripts/clean-dist.mjs && tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "all": "npm run typecheck && npm test && npm run build",
    "sync-spec": "node scripts/sync-spec.mjs"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.0"
  }
}
